# Keep the build context small and the image clean. Anything not needed to compile and publish
# the API is excluded — build output most of all, since copying a host bin/ into the image is how
# a stale or wrong-platform assembly ends up shipping.

**/bin/
**/obj/
**/out/
**/.vs/
**/.vscode/
**/.idea/

.git/
.gitignore
.gitattributes
.dockerignore

# Tests are run by the pipeline as their own stage, not inside the image build.
tests/

# Documentation and delivery definitions have no bearing on the image.
*.md
infra/
verify_brief_not_injected.py
*.pdf

**/*.user
**/*.suo
**/TestResults/
**/coverage*.xml
**/*.trx
